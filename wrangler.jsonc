{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teams-notion-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "observability": { "enabled": true }
  // 비밀값(FORM_PASSWORD, NOTION_TOKEN, NOTION_DATABASE_ID)은
  // 로컬은 .dev.vars, 배포는 `npx wrangler secret put <NAME>`으로 설정한다.
}
